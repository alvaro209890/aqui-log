NODE_ENV=development
PORT=3001
# Timezone operacional (trends, dia local, jobs)
APP_TIMEZONE=America/Sao_Paulo

DATABASE_HOST=localhost
# Local costuma ser 5433 se 5432 estiver ocupada (Atlas etc.)
DATABASE_PORT=5433
DATABASE_NAME=aqui_log
DATABASE_USER=aqui_log
DATABASE_PASSWORD=aqui_log_dev
DATABASE_SYNC=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=troque-esta-chave-em-producao
# Access token (curto em prod; 1d ok em dev local)
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_DAYS=30

# Precificacao server-side (centavos)
# Preco v2 (B2C-02 / DEC-02). Valores PROVISORIOS: sao so o ponto de partida,
# e tudo e editavel no painel admin sem deploy (persistido em Redis).
PRICING_BASE_FEE_CENTS=700
PRICING_MIN_FEE_CENTS=900
PRICING_PLATFORM_FEE_PERCENT=20
# Legado v1, usado como fallback quando nao ha tarifa por modo
PRICING_PER_KM_CENTS=250
# DEC-19: imediato precisa ser ESTRITAMENTE maior que agendado
PRICING_PER_KM_IMMEDIATE_CENTS=250
PRICING_PER_KM_SCHEDULED_CENTS=180
# Adicional cobrado acima da ultima faixa de peso
PRICING_ABOVE_TOP_BAND_CENTS=1500

# Multas e cutoffs (FLOW-DEC-01). Editaveis no admin; a COBRANCA automatica
# ainda nao existe (depende de PAY-01 / COUR-02).
COURIER_CANCEL_FEE_CENTS=300
COURIER_CANCEL_CUTOFF_IMMEDIATE=5
COURIER_CANCEL_CUTOFF_SCHEDULED=60
CUSTOMER_CANCEL_FEE_CENTS=0

# Ofertas: TTL em segundos (default 120 = 2 min)
OFFER_TTL_SECONDS=120

ADMIN_NAME=Administrador Aqui Log
ADMIN_EMAIL=admin@aquilog.com.br
ADMIN_PASSWORD=TroqueEstaSenha123!

VITE_API_URL=http://localhost:3001/api/v1
PUBLIC_API_URL=http://localhost:3001/api/v1
GEO_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_DRIVER=local

# --- Cloud scaffold (nao vinculados; deixar desligado em local) ---
# FIREBASE_ENABLED=false
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# VITE_API_URL=https://YOUR-RENDER-API.onrender.com/api/v1
